---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>CODEJOD | Soluciones Tecnológicas</title>
    <meta
      name="description"
      content="CODEJOD | Soluciones Tecnológicas en desarrollo web, móvil y software a medida."
    />
    <meta property="og:title" content="CODEJOD | Soluciones Tecnológicas" />
    <meta
      property="og:description"
      content="CODEJOD | Soluciones Tecnológicas en desarrollo web, móvil y software a medida."
    />
    <meta property="og:image" content="/img/logo_codejod.png" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="robots" content="index, follow" />
  </head>
  <body>
    <main class="bg-[url('/img/background.svg')] bg-cover bg-center bg-fixed">
      <header>
        <Navbar />
      </header>
      <slot />
      <Footer />
    </main>
    <script>
      import "flowbite";
    </script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    scroll-behavior: smooth;
    font-family: Montserrat-Regular, system-ui, sans-serif;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
