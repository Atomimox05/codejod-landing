---
import ServicesItems from "../ServicesItems.astro";

const services = [
  {
    id: 1,
    title: "Desarrollo de aplicaciones web y móviles",
    img: "/img/dev_apps.webp",
    alt: "Imagen de Freepik",
  },
  {
    id: 2,
    title: "Instalación y configuración de servidores",
    img: "/img/config_servers.webp",
    alt: "Imagen de Freepik",
  },
  {
    id: 3,
    title: "Instalación de infraestructura de redes",
    img: "/img/config_switch.webp",
    alt: "Imagen de Freepik",
  },
  {
    id: 4,
    title: "Soporte técnico",
    img: "/img/mantem_pc.webp",
    alt: "Imagen de Freepik",
  },
  {
    id: 5,
    title: "Venta de equipos de escritorio y periféricos",
    img: "/img/pc_rgb.webp",
    alt: "Imagen de Freepik",
  },
];
---

<section id="services" transition:name="services">
  <div class="p-8 mx-auto max-w-screen-xl">
    <h2
      class="text-4xl text-sky-950 uppercase text-center font-extrabold leading-10 tracking-wide"
    >
      Servicios
    </h2>
    <p class="text-center font-light mt-6">
      En <span class="font-bold">CODEJOD</span> ofrecemos una amplia gama de servicios
      para ayudar a nuestros clientes a alcanzar sus objetivos tecnológicos. Desde
      el desarrollo de aplicaciones web y móviles hasta la consultoría en tecnología,
      nuestro equipo de expertos está listo para ayudarte a llevar tu proyecto al
      siguiente nivel.
    </p>
  </div>
  <div
    class="p-8 mx-auto max-w-screen-xl grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"
  >
    {services.map((service) => <ServicesItems {...service} />)}
  </div>
</section>
