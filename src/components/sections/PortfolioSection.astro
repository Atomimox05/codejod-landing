---

<section
  id="portfolio"
  class="bg-gray-50/50 py-12 rounded-3xl mb-12 border border-gray-100 shadow-sm"
>
  <div class="p-8 mx-auto max-w-screen-xl">
    <h2
      class="text-4xl text-sky-950 uppercase text-center font-extrabold leading-10 tracking-wide mb-12"
    >
      Portafolio
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {Proyects.map((item) => <PortfolioItems {...item} />)}
    </div>
    <div class="mt-16 text-center">
      <h3
        class="text-xl font-semibold text-gray-900 inline-flex items-center gap-2"
      >
        <span class="flex w-3 h-3 bg-sky-500 rounded-full animate-pulse"></span>
        ¡Y muchos más proyectos en desarrollo!
      </h3>
    </div>
  </div>
</section>
