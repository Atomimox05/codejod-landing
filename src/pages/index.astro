---
import Layout from "../layouts/Layout.astro";
import HeroAbout from "../components/sections/HeroAbout.astro";
import ServicesSection from "../components/sections/ServicesSection.astro";
import PortfolioSection from "../components/sections/PortfolioSection.astro";
import ContactSection from "../components/sections/ContactSection.astro";
import ClientsSection from "../components/sections/ClientsSection.astro";
---

<Layout>
  <div class="flex flex-col gap-8 md:gap-32 pb-24">
    <div class="mt-8 md:mt-18 pt-10">
      <HeroAbout />
    </div>
    <div>
      <ServicesSection />
    </div>
    <div>
      <ClientsSection />
    </div>
    <div>
      <PortfolioSection />
    </div>
    <div>
      <ContactSection />
    </div>
  </div>
</Layout>
