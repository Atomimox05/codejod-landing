<section id="services" transition:name="services">
    <div class="p-8 mx-auto max-w-screen-xl">
        <h2 class="text-4xl text-sky-950 uppercase text-center font-extrabold leading-10 tracking-wide">
            Servicios
        </h2>
        <p class="text-center text-sm font-light mt-6">
            En <span class="font-bold">CODEJOD</span> ofrecemos una amplia gama de servicios para ayudar a nuestros clientes a alcanzar sus objetivos tecnológicos. Desde el desarrollo de aplicaciones web y móviles hasta la consultoría en tecnología, nuestro equipo de expertos está listo para ayudarte a llevar tu proyecto al siguiente nivel.
        </p>
    </div>
    <div class="p-8 mx-auto max-w-screen-xl grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <div class="bg-white/25 backdrop-blur-sm border border-gray-200 rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300">
            <img class="w-full h-64 object-cover rounded-t-xl cursor-pointer hover:scale-95 transform transition-transform duration-200" src="/img/dev_apps.webp" alt="Programando aplicaciones | Imagen de freepik" />
            <div class="p-6">
                <h5 class="font-semibold text-gray-900 text-center">Desarrollo de aplicaciones web y móviles</h5>
            </div>
        </div>
        <div class="bg-white/25 backdrop-blur-sm border border-gray-200 rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300">
            <img class="w-full h-64 object-cover rounded-t-xl cursor-pointer hover:scale-95 transform transition-transform duration-200" src="/img/config_servers.webp" alt="Configurando servidores | Imagen de senivpetro en Freepik" />
            <div class="p-6">
                <h5 class="font-semibold text-gray-900 text-center">Instalación y configuración de servidores</h5>
            </div>
        </div>
        <div class="bg-white/25 backdrop-blur-sm border border-gray-200 rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300">
            <img class="w-full h-64 object-cover rounded-t-xl cursor-pointer hover:scale-95 transform transition-transform duration-200" src="/img/config_switch.webp" alt="Instalando redes | Imagen de victor217 en Freepik" />
            <div class="p-6">
                <h5 class="font-semibold text-gray-900 text-center">Instalación de infraestructura de redes</h5>
            </div>
        </div>
        <div class="bg-white/25 backdrop-blur-sm border border-gray-200 rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300">
            <img class="w-full h-64 object-cover rounded-t-xl cursor-pointer hover:scale-95 transform transition-transform duration-200" src="/img/mantem_pc.webp" alt="Mantenimiento a equipos | Imagen de tonodiaz en Freepik" />
            <div class="p-6">
                <h5 class="font-semibold text-gray-900 text-center">Soporte técnico</h5>
            </div>
        </div>
        <div class="bg-white/25 backdrop-blur-sm border border-gray-200 rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300">
            <img class="w-full h-64 object-cover rounded-t-xl cursor-pointer hover:scale-95 transform transition-transform duration-200" src="/img/pc_rgb.webp" alt="Venta de PC | Imagen de freepik" />
            <div class="p-6">
                <h5 class="font-semibold text-gray-900 text-center">Venta de equipos de escritorio y periféricos</h5>
            </div>
        </div>
    </div>
</section>