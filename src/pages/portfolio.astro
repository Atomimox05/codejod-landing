---
    import PortfolioItems from '../components/PortfolioItems.astro';

    const Proyects = [
        {
            id: 1,
            title: "Gestor de tareas administrativas",
            description: "Una PWA creada con el objetivo de asignar, visualizar y gestionar tareas de una empresa. Así como controlar la efectividad de los trabajos realizados.",
            img: [
                '/img/app-tareas/appt-1.png',
                '/img/app-tareas/appt-2.png',
                '/img/app-tareas/appt-3.png',
                '/img/app-tareas/appt-4.png',
                '/img/app-tareas/appt-5.png'
            ],
            tech: [
                'Python', 'Django', 'MySQL', 'Typescript', 'Svelte', 'Tailwind'
            ]
        },
        {
            id: 2,
            title: "Sistema de control de cirugías",
            description: "Una herramienta digital que permite a los organismos de salud gestionar sus procedimientos quirúrgicos. El sistema registra fecha, hora, médico encargado y quirófano para cada cirugía. Esto ayuda a garantizar que las cirugías se realicen ordenadamente, lo que mejora la seguridad del paciente.",
            img: [
                '/img/cirugias/cirugias-1.png',
                '/img/cirugias/cirugias-2.png',
                '/img/cirugias/cirugias-3.png',
                '/img/cirugias/cirugias-4.png',
            ],
            tech: [
                'Python', 'Django', 'PostgresSQL', 'JavaScript', 'Vue', 'Bootstrap'
            ]
        },
        {
            id: 3,
            title: "Sistema de atención al paciente",
            description: "Una aplicación diseñada para mejorar la comunicación entre pacientes, méidicos y equipos administrativos. A través de esta herramienta, los pacientes podrán reportar en tiempo real su satisfacción con servicios como atención de enfermería, trato médico o estado de las habitaciones, garantizando que cada solicitud sea gestionada inmediatamente.",
            img: [
                '/img/habitaciones/hab-1.png',
                '/img/habitaciones/hab-2.png',
                '/img/habitaciones/hab-3.png',
                '/img/habitaciones/hab-4.png',
                '/img/habitaciones/hab-5.png',
                '/img/habitaciones/hab-6.png',
                '/img/habitaciones/hab-7.png'
            ],
            tech: [
                'Python', 'Django', 'PostgresSQL', 'JavaScript', 'Astro', 'Tailwind'
            ]
        },
        {
            id: 4,
            title: "Páginas web Grupo El Paso",
            description: "Páginas web creadas para las clínicas Centro Médico Docente el Paso y Policlínica Altos Mirandinos, que incluyen buscador y listado médico.",
            img: [
                '/img/web-grupoelpaso/cmdep-1.png', 
                '/img/web-grupoelpaso/cmdep-2.png', 
                '/img/web-grupoelpaso/poli-1.png', 
                '/img/web-grupoelpaso/poli-2.png'
            ],
            tech: [
                'Python', 'Django', 'PostgresSQL', 'JavaScript', 'Astro', 'Tailwind'
            ]
        },
        {
            id: 5,
            title: "Sistema de control de inventario",
            description: "Un sistema diseñado para gestionar el inventario de una empresa. Permite registrar productos, manejar precios de compra y venta, controlar existencias y generar informes de entrada y salida.",
            img: [
                '/img/inventario/inv-1.png',
                '/img/inventario/inv-2.png',
                '/img/inventario/inv-3.png'
            ],
            tech: [
                'Python', 'Django', 'PostgresSQL', 'JavaScript', 'Svelte', 'Bootstrap'
            ]
        }
    ]
---

<section id="portfolio">
    <div class="p-8 mx-auto max-w-screen-xl">
        <h2 class="text-4xl text-sky-950 uppercase text-center font-extrabold leading-10 tracking-wide">
            Portafolio
        </h2>
    </div>
    <div class="p-8 lg:p-4 mx-auto max-w-screen-xl grid grid-cols-1 items-center lg:grid-cols-2 gap-4">
        <img 
            class="h-full hidden lg:block w-screen object-cover" 
            src="/img/man-portfolio.webp" 
            alt="Portafolio profesional"
            loading="lazy"
        >
        <div class="">
            <ol class="relative border-s border-cyan-800/30">                  
                {Proyects.map((item) => (
                    <li class="mb-10 ms-6 list-none">            
                        <PortfolioItems {... item} />
                    </li>
                ))}
                <li class="ms-6 list-none">
                    <span class="absolute flex items-center justify-center w-6 h-6 bg-sky-800 rounded-full -start-3"></span>
                    <h3 class="mb-1 text-lg font-semibold text-gray-900">¡Y más proyectos en desarrollo!</h3>
                </li>
            </ol>
        </div>
    </div>
</section>