---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Página no encontrada | CODEJOD"
  description="La página que buscas no existe o fue movida."
  noindex
>
  <section class="min-h-[60vh] flex items-center justify-center px-8 py-24">
    <div class="text-center max-w-xl">
      <p
        class="text-7xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-sky-400 to-blue-800"
      >
        404
      </p>
      <h1 class="mt-4 text-3xl font-extrabold text-sky-950">
        Página no encontrada
      </h1>
      <p class="mt-4 text-gray-700">
        La página que buscas no existe o fue movida. Vuelve al inicio para
        conocer nuestros servicios.
      </p>
      <a
        href="/"
        class="mt-8 inline-flex items-center justify-center px-6 py-3 text-base font-medium text-white bg-gradient-to-r from-sky-500 to-blue-700 rounded-lg hover:from-sky-600 hover:to-blue-800 focus:ring-4 focus:ring-blue-300 shadow-lg"
      >
        Volver al inicio
      </a>
    </div>
  </section>
</Layout>
